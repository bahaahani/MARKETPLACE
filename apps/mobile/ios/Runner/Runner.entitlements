<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal links: https://SAHEL_WEB_HOST/{en|ar}/... opens the app. SAHEL_WEB_HOST comes from ios/Flutter/<Flavor>.xcconfig.
	     The host must serve /.well-known/apple-app-site-association (apps/web/public/.well-known/). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:$(SAHEL_WEB_HOST)</string>
	</array>
</dict>
</plist>
